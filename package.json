{
  "name": "sprintboard-git-simulacro",
  "version": "1.0.0",
  "description": "Mini proyecto para practicar Feature Branch Flow con Node.js, Express, Prisma 6, MySQL y JWT",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "setup": "npm install && prisma generate && prisma migrate dev --name init && node prisma/seed.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "supertest": "^7.1.4"
  }
}
